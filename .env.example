# Copy to .env on the server. Never commit the real file.

DATABASE_URL=postgres://user:password@host:5432/gotham
SESSION_SECRET=change-this-to-a-long-random-string
ALLOW_ORIGINS=https://gothamconsult.com,https://www.gothamconsult.com,https://gotham.84-12-73-59.sslip.io,https://gotham-consult-gh.netlify.app

# Seeds the first owner account when the database is empty
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this
ADMIN_NAME=Owner

PUBLIC_URL=https://gothamconsult.com
SITE_URL=https://gothamconsult.com
MAIL_FROM=Gotham Consult <info@gothamconsult.com>

# Optional Google sign-in for existing active team accounts only.
# Add this callback URI to the Google OAuth web client:
# https://gothamconsult.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional shared mailbox for CRM inbox and SMTP replies. Keep credentials server-side only.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASS=
IMAP_MAILBOX=INBOX

# Leave empty and mail waits in the outbox to be sent by hand.
RESEND_API_KEY=

# Ask Gotham uses an OpenAI-compatible API; keep the real key only in the server's .env/secret store.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_REASONING=
ASK_DAILY_CAP=400

MEDIA_DIR=/data/media
